ARG RUST_VERSION=1.99.1
FROM rust:${RUST_VERSION}-slim-bookworm

# Build tools stay in the disposable container. OpenSSL remains a dynamic
# runtime dependency of the Linux artifact; Windows uses system Schannel.
RUN if [ "$(dpkg --print-architecture)" = arm64 ]; then dpkg --add-architecture amd64; fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils libssl-dev libssl-dev:amd64 pkg-config procps \
        gcc-x86-64-linux-gnu libc6-dev-amd64-cross qemu-user \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add x86_64-unknown-linux-gnu

ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc
WORKDIR /work
