# Address reachable by both the agent and target computers.
# For a public deployment, use the HTTPS URL of your reverse proxy.
AGENTERM_PUBLIC_URL=http://localhost:8080

# Generate a value with: openssl rand -hex 24
# Required by Compose; do not share or commit your .env file.
AGENTERM_MANAGEMENT_KEY=

# Loopback is suitable for a reverse proxy on the Docker host.
# For direct access from a trusted LAN, use 0.0.0.0.
AGENTERM_BIND_ADDRESS=127.0.0.1
AGENTERM_PORT=8080

# Compose logs both Server and Runtime to the platform collector with rotation.
AGENTERM_LOG_FORMAT=json
AGENTERM_LOG_LEVEL=INFO
